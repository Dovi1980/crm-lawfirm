# CRM Lawfirm Configuration Environment Template
# Copy this file to '.env' and fill in the values before launching containers.

# Database settings (PostgreSQL)
# Note: For async SQLAlchemy, we use the 'postgresql+asyncpg' driver
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass@db:5432/crm_lawfirm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=crm_lawfirm

# Security & Authentication
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=replace_this_with_a_64_character_hexadecimal_string_for_production
ENABLE_RATE_LIMITER=False
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,https://tudominio.com

# SMTP settings (Transactional mail for password recovery)
# Fallback to local log printing is active if SMTP_HOST is blank
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@tudominio.com

# Initial Seeding Credentials
FIRST_ADMIN_EMAIL=admin@estudio.com
FIRST_ADMIN_PASSWORD=AdminLawFirm2026!
