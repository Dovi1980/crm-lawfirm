# ==============================================================================
# CRM LAWFIRM — CONFIGURATION ENVIRONMENT TEMPLATE
# ==============================================================================

# 1. DATABASE SETTINGS (POSTGRESQL)
# For local development (outside Docker), use 'localhost' as host.
# For Docker Compose, use the service name 'db' as host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=crm_lawfirm

# SQLAlchemy connection URLs (asyncpg driver is required for async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass@localhost:5432/crm_lawfirm
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:postgres_secure_pass@db:5432/crm_lawfirm

# 2. AI & LLM PROVIDERS (universal layer)
# Each firm plugs in whichever provider they already pay for.
# Switching providers is a config change — no code edits needed.
AI_ENABLED=True
AI_PROVIDER=anthropic                  # anthropic | openai | gemini
AI_MODEL_DEFAULT=claude-sonnet-4-6     # default model id for the chosen provider
AI_MODEL_DEEP=                         # optional: model for heavy drafting (e.g. claude-opus-4-8)

# Provider credentials (set only the one matching AI_PROVIDER)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=                       # leave empty for OpenAI; set for Azure OpenAI / self-hosted
GEMINI_API_KEY=

# Subida de documentación escaneada (adjuntos por caso)
UPLOAD_DIR=/data/attachments           # volumen Docker montado
MAX_UPLOAD_MB=15                       # tope por archivo (bajo el límite inline de Gemini)
ALLOWED_UPLOAD_MIME=application/pdf,image/png,image/jpeg,image/jpg,image/webp

# 3. SECURITY & AUTHENTICATION
# Generate a secure key using in PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { [byte](Get-Random -Minimum 0 -Maximum 256) }))
SECRET_KEY=replace_this_with_a_64_character_hexadecimal_string_for_production
ENABLE_RATE_LIMITER=True
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie hardening for refresh token transport.
# COOKIE_SECURE must be True when serving over HTTPS in production.
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# 4. CORS ALLOWED ORIGINS (Comma-separated)
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,https://tudominio.com

# 5. SMTP EMAIL SETTINGS (Transactional mail for password recovery)
# Fallback to local console printing is active if SMTP_HOST is blank
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@tudominio.com

# 6. INITIAL SEEDING CREDENTIALS
FIRST_ADMIN_EMAIL=admin@estudio.com
FIRST_ADMIN_PASSWORD=AdminLawFirm2026!

# 7. DOCKER EXPORTED PORTS
DOCKER_POSTGRES_PORT=5432
DOCKER_FASTAPI_PORT=8000
DOCKER_FRONTEND_PORT=5173
DOCKER_NGINX_PORT=80
